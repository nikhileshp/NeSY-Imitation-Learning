setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.4219871587315455) :-  /* #neg=550 #pos=711 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), facingright(A), visiblediver(A, _), !).
(action(A, _, 0.5905472520700543) :-  /* #neg=954 #pos=2,611 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(action(A, _, 0.1438852973310015) :-  /* #neg=4,622 #pos=1,849 */ belowwatersurface(A), visibleenemysubmarine(A, _), !).
(action(_, _, -0.09983248381941032) :-  /* #neg=4,537 #pos=199 */ !).
