setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.2699136409818612) :-  /* #neg=210 #pos=147 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), rightofenemy(A, UniqueVar1), facingright(A), !).
(action(A, _, 0.5734001177983133) :-  /* #neg=1,264 #pos=3,175 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(action(A, _, 0.14296101150123233) :-  /* #neg=4,643 #pos=1,849 */ belowwatersurface(A), visibleenemysubmarine(A, _), !).
(action(_, _, -0.10009697341916526) :-  /* #neg=4,567 #pos=199 */ !).
