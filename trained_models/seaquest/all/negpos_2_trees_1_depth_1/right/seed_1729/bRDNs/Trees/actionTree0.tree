setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.7292290744723295) :-  /* #neg=444 #pos=3,000 */ visibleenemy(A, _), facingright(A), visiblediver(A, UniqueVar1), samelevelasdiver(A, UniqueVar1), !).
(action(A, _, 0.3458577656484332) :-  /* #neg=4,293 #pos=4,087 */ visibleenemy(A, _), facingright(A), !).
(action(A, _, 0.3805775712571874) :-  /* #neg=1,054 #pos=1,153 */ facingright(A), visiblediver(A, _), !).
(action(_, _, -0.0961058607686671) :-  /* #neg=11,640 #pos=558 */ !).
