setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.7020094707235598) :-  /* #neg=618 #pos=3,340 */ belowwatersurface(A), facingleft(A), visiblediver(A, UniqueVar1), samelevelasdiver(A, UniqueVar1), !).
