setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.7030768379580956) :-  /* #neg=613 #pos=3,340 */ belowwatersurface(A), facingleft(A), visiblediver(A, UniqueVar1), samelevelasdiver(A, UniqueVar1), !).
