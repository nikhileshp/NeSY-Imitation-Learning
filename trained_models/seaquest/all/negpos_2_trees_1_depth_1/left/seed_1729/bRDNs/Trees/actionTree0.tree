setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.6954515172002843) :-  /* #neg=649 #pos=3,340 */ facingleft(A), visiblediver(A, UniqueVar1), samelevelasdiver(A, UniqueVar1), !).
(action(A, _, 0.291353236174776) :-  /* #neg=6,589 #pos=5,036 */ facingleft(A), !).
