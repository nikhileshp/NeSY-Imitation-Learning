(action(A, _, 0.05295412990470718) :-  /* #neg=62 #pos=15 */ visibleenemy(A, UniqueVar1), facingright(A), visiblediver(A, UniqueVar2), samelevelasdiver(A, UniqueVar2), rightofdiver(A, UniqueVar2), belowofenemy(A, UniqueVar1), !).
(action(A, _, 0.7386799085508348) :-  /* #neg=405 #pos=2,985 */ visibleenemy(A, _), facingright(A), visiblediver(A, UniqueVar3), samelevelasdiver(A, UniqueVar3), !).
(action(A, _, 0.253421958734389) :-  /* #neg=2,226 #pos=1,455 */ visibleenemy(A, _), facingright(A), visibleenemysubmarine(A, UniqueVar4), rightofsubmarine(A, UniqueVar4), !).
(action(A, _, 0.43082082369828884) :-  /* #neg=1,964 #pos=2,632 */ visibleenemy(A, _), facingright(A), !).
(action(A, _, -0.0734100002617066) :-  /* #neg=1,715 #pos=126 */ facingleft(A), visibleenemy(A, UniqueVar5), samelevelasenemy(A, UniqueVar5), !).
(action(A, _, -0.11692814609268067) :-  /* #neg=7,590 #pos=194 */ facingleft(A), !).
(action(A, _, 0.366750611323592) :-  /* #neg=1,114 #pos=1,153 */ facingright(A), visiblediver(A, _), !).
(action(_, _, -0.054318883951611635) :-  /* #neg=2,481 #pos=238 */ !).
