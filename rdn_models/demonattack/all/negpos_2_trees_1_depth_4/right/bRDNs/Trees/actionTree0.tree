setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, -0.1418510649004878) :-  /* #neg=6 */ visibleenemy(A, _), visibleenemymissile(A, _), !).
(action(A, _, 0.8581489350995121) :-  /* #pos=3 */ visibleenemy(A, UniqueVar1), enemydirectlyabove(A, UniqueVar1), visibleenemy(A, UniqueVar2), rightofenemy(A, UniqueVar2), !).
(action(A, _, 0.41370449065506787) :-  /* #neg=4 #pos=5 */ visibleenemy(A, UniqueVar3), enemydirectlyabove(A, UniqueVar3), !).
(action(A, _, -0.1418510649004878) :-  /* #neg=6 */ visibleenemy(A, UniqueVar4), leftofenemy(A, UniqueVar4), !).
(action(A, _, 0.5248156017661789) :-  /* #neg=2 #pos=4 */ visibleenemy(A, _), !).
(action(_, _, 0.10814893509951218) :-  /* #neg=6 #pos=2 */ !).
