setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.3581489350995122) :-  /* #neg=2 #pos=2 */ samelevelascar(A, UniqueVar1), rightofcar(A, UniqueVar1), carabove(A, UniqueVar2), rightofcar(A, UniqueVar2), !).
(action(A, _, 0.8581489350995122) :-  /* #pos=5 */ samelevelascar(A, UniqueVar3), rightofcar(A, UniqueVar3), !).
(action(_, _, -0.1418510649004878) :-  /* #neg=12 */ !).
