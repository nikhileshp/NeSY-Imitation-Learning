setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, 0.4501660026875221) :-  /* #neg=5 #pos=1 */ diversfull(A), facingleft(A), visiblediver(A, UniqueVar1), belowofdiver(A, UniqueVar1), !).
(fire(A, 0.4501660026875224) :-  /* #neg=30 */ diversfull(A), facingleft(A), visiblediver(A, _), !).
(fire(A, 0.4501660026875221) :-  /* #neg=5 #pos=1 */ diversfull(A), facingleft(A), !).
(fire(A, 0.45016600268752216) :-  /* #neg=4 */ diversfull(A), visiblemissile(A, _), !).
(fire(A, 0.4501660026875223) :-  /* #neg=15 #pos=5 */ diversfull(A), visibleenemysubmarine(A, _), !).
(fire(A, 0.45016600268752216) :-  /* #neg=5 */ diversfull(A), !).
(fire(_, 0.450166002687524) :-  /* #neg=551 #pos=307 */ !).
