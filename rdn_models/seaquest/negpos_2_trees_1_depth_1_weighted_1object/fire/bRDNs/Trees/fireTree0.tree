setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, 0.29058136753194347) :-  /* #neg=42 #pos=32 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), leftofenemy(A, UniqueVar1), visiblediver(A, _), !).
(fire(A, 0.6303497073002826) :-  /* #neg=59 #pos=200 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(fire(A, -0.09134601439543759) :-  /* #neg=282 #pos=15 */ visiblediver(A, _), !).
(fire(_, 0.05462987351593518) :-  /* #neg=274 #pos=67 */ !).
