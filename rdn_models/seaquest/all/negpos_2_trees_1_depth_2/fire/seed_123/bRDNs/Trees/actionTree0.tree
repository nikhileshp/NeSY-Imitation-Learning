setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.4219871587315455) :-  /* #neg=550 #pos=711 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), facingright(A), visiblediver(A, _), !).
(action(A, _, 0.5961364986947589) :-  /* #neg=927 #pos=2,611 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(action(A, _, 0.14308324665043703) :-  /* #neg=4,191 #pos=1,670 */ visibleenemysubmarine(A, UniqueVar3), belowofsubmarine(A, UniqueVar3), !).
(action(_, _, -0.07207074368948845) :-  /* #neg=5,039 #pos=378 */ !).
