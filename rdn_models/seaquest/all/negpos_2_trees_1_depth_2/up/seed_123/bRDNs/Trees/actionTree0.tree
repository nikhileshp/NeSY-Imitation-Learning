setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.10768425108463739) :-  /* #neg=1,615 #pos=537 */ visibleenemy(A, UniqueVar1), belowofenemy(A, UniqueVar1), visiblediver(A, UniqueVar2), samelevelasdiver(A, UniqueVar2), !).
(action(A, _, 0.3783158335696045) :-  /* #neg=5,520 #pos=5,984 */ visibleenemy(A, UniqueVar3), belowofenemy(A, UniqueVar3), !).
(action(A, _, 0.25379990718095924) :-  /* #neg=6,559 #pos=4,294 */ visibleenemysubmarine(A, UniqueVar4), belowofsubmarine(A, UniqueVar4), !).
(action(_, _, -0.021022907550595604) :-  /* #neg=10,616 #pos=1,459 */ !).
