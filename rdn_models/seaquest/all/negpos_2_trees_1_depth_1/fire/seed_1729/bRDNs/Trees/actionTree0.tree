setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.4310739955346404) :-  /* #neg=530 #pos=711 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), facingright(A), visiblediver(A, _), !).
(action(A, _, 0.5876823243143718) :-  /* #neg=968 #pos=2,611 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(action(A, _, 0.14057748236823706) :-  /* #neg=4,243 #pos=1,670 */ visibleenemysubmarine(A, UniqueVar3), belowofsubmarine(A, UniqueVar3), !).
(action(_, _, -0.07240406875865732) :-  /* #neg=5,065 #pos=378 */ !).
