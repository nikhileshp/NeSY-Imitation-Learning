setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.7358551960708355) :-  /* #neg=418 #pos=3,000 */ visibleenemy(A, _), facingright(A), visiblediver(A, UniqueVar1), samelevelasdiver(A, UniqueVar1), !).
(action(A, _, 0.3476686380579453) :-  /* #neg=4,262 #pos=4,087 */ visibleenemy(A, _), facingright(A), !).
(action(A, _, 0.2699576047557105) :-  /* #neg=1,574 #pos=1,102 */ facingright(A), diversnotfull(A), !).
(action(_, _, -0.09099936149367861) :-  /* #neg=11,367 #pos=609 */ !).
