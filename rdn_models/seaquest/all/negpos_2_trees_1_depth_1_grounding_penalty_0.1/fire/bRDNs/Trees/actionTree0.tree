setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(action(A, _, 0.5570139435515719) :-  /* #neg=1,247 #pos=2,894 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), diversnotfull(A), !).
(action(A, _, 0.48848766853102465) :-  /* #neg=251 #pos=428 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
