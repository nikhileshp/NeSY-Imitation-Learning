setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(up(A, 0.6816783468642181) :-  /* #neg=3 #pos=14 */ visibleenemy(A, UniqueVar1), belowofenemy(A, UniqueVar1), visiblediver(A, UniqueVar2), samelevelasdiver(A, UniqueVar2), diversfull(A), !).
(up(A, 0.04177725368358309) :-  /* #neg=369 #pos=83 */ visibleenemy(A, UniqueVar3), belowofenemy(A, UniqueVar3), visiblediver(A, UniqueVar4), samelevelasdiver(A, UniqueVar4), !).
(up(A, 0.2898259537330481) :-  /* #neg=366 #pos=278 */ visibleenemy(A, UniqueVar5), belowofenemy(A, UniqueVar5), diversnotfull(A), visiblediver(A, _), !).
