setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(up(A, 0.0610778053923985) :-  /* #neg=381 #pos=97 */ visibleenemy(A, UniqueVar1), belowofenemy(A, UniqueVar1), visiblediver(A, UniqueVar2), samelevelasdiver(A, UniqueVar2), !).
(up(A, 0.39907760910620926) :-  /* #neg=959 #pos=1,130 */ visibleenemy(A, UniqueVar3), belowofenemy(A, UniqueVar3), !).
(up(A, 0.4421088348488816) :-  /* #neg=166 #pos=233 */ visiblediver(A, UniqueVar4), belowofdiver(A, UniqueVar4), !).
(up(_, 0.047424389935128354) :-  /* #neg=2,540 #pos=593 */ !).
