setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, -0.1418510649004878) :-  /* #neg=16 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), facingright(A), rightofenemy(A, UniqueVar1), !).
(fire(A, 0.5900101338376801) :-  /* #neg=85 #pos=232 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(fire(A, -0.08185106490048785) :-  /* #neg=235 #pos=15 */ visiblediver(A, _), !).
(fire(_, 0.047950634816226696) :-  /* #neg=286 #pos=67 */ !).
