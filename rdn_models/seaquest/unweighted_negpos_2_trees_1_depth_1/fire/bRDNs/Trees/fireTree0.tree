setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, 0.2737333506839266) :-  /* #neg=45 #pos=32 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), leftofenemy(A, UniqueVar1), visiblediver(A, _), !).
(fire(A, 0.6363590518310279) :-  /* #neg=57 #pos=200 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(fire(A, -0.09012692696945358) :-  /* #neg=275 #pos=15 */ visiblediver(A, _), !).
(fire(_, 0.05012601246340969) :-  /* #neg=282 #pos=67 */ !).
