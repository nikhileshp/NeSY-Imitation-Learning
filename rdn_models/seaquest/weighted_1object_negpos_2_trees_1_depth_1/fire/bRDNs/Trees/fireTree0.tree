setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, 0.7340613438586343) :-  /* #neg=17 #pos=120 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), facingleft(A), rightofenemy(A, UniqueVar1), !).
(fire(A, 0.4507415276921028) :-  /* #neg=77 #pos=112 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(fire(A, -0.09100360727336944) :-  /* #neg=280 #pos=15 */ visiblediver(A, _), !).
(fire(_, 0.06884075899888413) :-  /* #neg=251 #pos=67 */ !).
