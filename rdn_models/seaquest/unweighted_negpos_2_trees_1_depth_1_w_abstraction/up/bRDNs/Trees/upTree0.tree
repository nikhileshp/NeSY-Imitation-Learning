(up(A, 0.050609252559828885) :-  /* #neg=407 #pos=97 */ visibleenemy(A, UniqueVar1), belowofenemy(A, UniqueVar1), visiblediver(A, UniqueVar2), samelevelasdiver(A, UniqueVar2), !).
(up(A, 0.39907760910620926) :-  /* #neg=959 #pos=1,130 */ visibleenemy(A, UniqueVar3), belowofenemy(A, UniqueVar3), !).
