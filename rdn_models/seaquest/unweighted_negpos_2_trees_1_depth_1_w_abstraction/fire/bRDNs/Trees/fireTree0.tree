setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, 0.6605441446803479) :-  /* #neg=33 #pos=134 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), diversnotfull(A), facingleft(A), !).
(fire(A, 0.4056349686190638) :-  /* #neg=81 #pos=98 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(fire(A, -0.08769944035175155) :-  /* #neg=262 #pos=15 */ visiblediver(A, _), !).
(fire(_, 0.06557927565678856) :-  /* #neg=256 #pos=67 */ !).
