setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, 0.3581489350995111) :-  /* #neg=32 #pos=32 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), leftofenemy(A, UniqueVar1), visiblediver(A, _), !).
(fire(A, 0.6215077137254645) :-  /* #neg=62 #pos=200 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), !).
(fire(A, 0.09443585493073636) :-  /* #neg=181 #pos=56 */ visibleenemysubmarine(A, UniqueVar3), belowofsubmarine(A, UniqueVar3), !).
(fire(_, -0.0667065562299675) :-  /* #neg=320 #pos=26 */ !).
