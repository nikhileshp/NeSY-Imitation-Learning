setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, 0.19148226843284552) :-  /* #neg=2 #pos=1 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), diversfull(A), nearbyenemy(A, UniqueVar1), !).
(fire(A, -0.1418510649004878) :-  /* #neg=7 */ visibleenemy(A, UniqueVar2), samelevelasenemy(A, UniqueVar2), diversfull(A), !).
(fire(A, -0.1418510649004878) :-  /* #neg=7 */ visibleenemy(A, UniqueVar3), samelevelasenemy(A, UniqueVar3), facingright(A), rightofenemy(A, UniqueVar3), !).
(fire(A, 0.6307241859356303) :-  /* #neg=68 #pos=231 */ visibleenemy(A, UniqueVar4), samelevelasenemy(A, UniqueVar4), !).
(fire(A, -0.0012260649004876617) :-  /* #neg=55 #pos=9 */ visiblediver(A, UniqueVar5), belowofdiver(A, UniqueVar5), visibleenemysubmarine(A, _), !).
(fire(A, -0.11715970687579673) :-  /* #neg=237 #pos=6 */ visiblediver(A, _), !).
(fire(A, 0.18423589162125137) :-  /* #neg=93 #pos=45 */ visibleenemysubmarine(A, UniqueVar6), belowofsubmarine(A, UniqueVar6), !).
(fire(_, -0.03758566205688577) :-  /* #neg=189 #pos=22 */ !).
