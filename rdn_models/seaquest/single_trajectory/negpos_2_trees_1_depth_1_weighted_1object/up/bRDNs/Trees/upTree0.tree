setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(up(A, 0.0602322684328448) :-  /* #neg=383 #pos=97 */ visibleenemy(A, UniqueVar1), belowofenemy(A, UniqueVar1), visiblediver(A, UniqueVar2), samelevelasdiver(A, UniqueVar2), !).
(up(A, 0.39091649757004027) :-  /* #neg=991 #pos=1,130 */ visibleenemy(A, UniqueVar3), belowofenemy(A, UniqueVar3), !).
(up(A, 0.41291083986141286) :-  /* #neg=187 #pos=233 */ visiblediver(A, UniqueVar4), belowofdiver(A, UniqueVar4), !).
(up(_, 0.044744278082515826) :-  /* #neg=2,585 #pos=593 */ !).
