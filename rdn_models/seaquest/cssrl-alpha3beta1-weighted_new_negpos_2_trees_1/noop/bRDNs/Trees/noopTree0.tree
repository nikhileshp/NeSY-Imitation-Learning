(noop(A, 0.7071624069763934) :-  /* #neg=265 #pos=16 */ visibleenemy(A, UniqueVar4), belowofenemy(A, UniqueVar4), facingleft(A), visiblediver(A, _), !).
(noop(A, 0.6938778813136349) :-  /* #neg=916 #pos=12 */ visibleenemy(A, UniqueVar5), belowofenemy(A, UniqueVar5), !).
(noop(A, 0.6899744811276146) :-  /* #neg=329 */ visiblediver(A, UniqueVar6), samelevelasdiver(A, UniqueVar6), !).
(noop(A, 0.68997448112761) :-  /* #neg=188 */ visibleenemy(A, UniqueVar7), samelevelasenemy(A, UniqueVar7), !).
