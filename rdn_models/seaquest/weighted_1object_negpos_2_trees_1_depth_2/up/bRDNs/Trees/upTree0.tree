(up(A, 0.29084124279181767) :-  /* #neg=118 #pos=90 */ visiblediver(A, UniqueVar7), belowofdiver(A, UniqueVar7), visibleenemy(A, UniqueVar8), leftofenemy(A, UniqueVar8), !).
