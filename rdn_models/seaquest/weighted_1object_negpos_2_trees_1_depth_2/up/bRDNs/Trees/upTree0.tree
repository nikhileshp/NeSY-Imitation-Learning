setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(up(A, 0.7867203636709409) :-  /* #neg=1 #pos=13 */ visibleenemy(A, UniqueVar1), belowofenemy(A, UniqueVar1), visiblediver(A, UniqueVar2), samelevelasdiver(A, UniqueVar2), diversfull(A), visibleenemysubmarine(A, _), !).
(up(A, 0.03802045544212467) :-  /* #neg=383 #pos=84 */ visibleenemy(A, UniqueVar3), belowofenemy(A, UniqueVar3), visiblediver(A, UniqueVar4), samelevelasdiver(A, UniqueVar4), !).
(up(A, 0.29184628299342347) :-  /* #neg=363 #pos=278 */ visibleenemy(A, UniqueVar5), belowofenemy(A, UniqueVar5), diversnotfull(A), visiblediver(A, _), !).
(up(A, 0.4401161482142618) :-  /* #neg=612 #pos=852 */ visibleenemy(A, UniqueVar6), belowofenemy(A, UniqueVar6), !).
(up(A, 0.3340525495573397) :-  /* #neg=174 #pos=158 */ visiblediver(A, UniqueVar7), belowofdiver(A, UniqueVar7), visibleenemy(A, _), !).
(up(A, 0.6646005480027387) :-  /* #neg=18 #pos=75 */ visiblediver(A, UniqueVar8), belowofdiver(A, UniqueVar8), !).
(up(A, 0.2958017468354494) :-  /* #neg=230 #pos=179 */ diversfull(A), !).
(up(_, 0.005427483658739546) :-  /* #neg=2,397 #pos=414 */ !).
