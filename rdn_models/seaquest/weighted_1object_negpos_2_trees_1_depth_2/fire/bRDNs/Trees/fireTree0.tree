(fire(A, 0.31968739663797385) :-  /* #neg=7 #pos=6 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), facingleft(A), rightofenemy(A, UniqueVar1), visiblemissile(A, UniqueVar2), aboveofmissile(A, UniqueVar2), !).
(fire(A, 0.696384229217158) :-  /* #neg=22 #pos=114 */ visibleenemy(A, UniqueVar3), samelevelasenemy(A, UniqueVar3), facingleft(A), rightofenemy(A, UniqueVar3), !).
