setParam: stringsAreCaseSensitive = true.

usePrologVariables: true.


(fire(A, 0.5185262935900773) :-  /* #neg=18 #pos=35 */ visibleenemy(A, UniqueVar1), samelevelasenemy(A, UniqueVar1), facingleft(A), rightofenemy(A, UniqueVar1), visibleenemy(A, UniqueVar2), leftofenemy(A, UniqueVar2), !).
(fire(A, 0.7721274297231676) :-  /* #neg=8 #pos=85 */ visibleenemy(A, UniqueVar3), samelevelasenemy(A, UniqueVar3), facingleft(A), rightofenemy(A, UniqueVar3), !).
(fire(A, 0.47693346548624976) :-  /* #neg=69 #pos=112 */ visibleenemy(A, UniqueVar4), samelevelasenemy(A, UniqueVar4), leftofenemy(A, UniqueVar4), !).
(fire(A, -0.1418510649004878) :-  /* #neg=11 */ visibleenemy(A, UniqueVar5), samelevelasenemy(A, UniqueVar5), !).
(fire(A, 0.005207758628924101) :-  /* #neg=58 #pos=10 */ visiblediver(A, UniqueVar6), belowofdiver(A, UniqueVar6), visibleenemy(A, _), !).
(fire(A, -0.11880959024611025) :-  /* #neg=212 #pos=5 */ visiblediver(A, _), !).
(fire(A, 0.17957750652808366) :-  /* #neg=95 #pos=45 */ visibleenemysubmarine(A, UniqueVar7), belowofsubmarine(A, UniqueVar7), !).
(fire(_, -0.0350549483956333) :-  /* #neg=184 #pos=22 */ !).
